Cell[BoxData[
 RowBox[{
  RowBox[{"tiLangrangeMultiplierCepheid", "[", 
   RowBox[{
   "inputSNList_", ",", "tTotalObservationhr_", ",", "snrEnhancement_"}], 
   "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"snPopList", "=", "inputSNList"}], ";", "\[IndentingNewLine]", 
    RowBox[{"sum1UncertaintyRatio", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           RowBox[{"\[Sigma]DoverDt0", "[", 
            RowBox[{
             RowBox[{"snPopList", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "snrEnhancement"}], "]"}], 
           
           RowBox[{"\[Sigma]CalibratorCepheid", "[", 
            RowBox[{"snPopList", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}]], ")"}], "2"], "t0hr"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "snPopList", "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"sum2UncertaintyRatio", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"(", 
        FractionBox[
         RowBox[{"\[Sigma]DoverDt0", "[", 
          RowBox[{
           RowBox[{"snPopList", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", "snrEnhancement"}], "]"}], 
         SuperscriptBox[
          RowBox[{"\[Sigma]CalibratorCepheid", "[", 
           RowBox[{"snPopList", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "2"]], ")"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "snPopList", "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"tiIdealCepheidsTab", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"mi", "=", 
         RowBox[{"snPopList", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ti", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"tTotalObservationhr", "+", "sum1UncertaintyRatio"}], 
            ")"}], "*", 
           FractionBox[
            FractionBox[
             RowBox[{"\[Sigma]DoverDt0", "[", 
              RowBox[{"mi", ",", "snrEnhancement"}], "]"}], 
             SuperscriptBox[
