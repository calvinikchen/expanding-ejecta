  RowBox[{"Interpolation", "[", 
   RowBox[{"Log10", "[", 
    RowBox[{"meanTypeIaCDLTable", "/.", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x_", ",", "y_"}], "}"}], "->", 
