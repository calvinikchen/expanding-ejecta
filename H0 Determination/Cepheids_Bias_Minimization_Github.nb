Cell[BoxData[
 RowBox[{
  RowBox[{"zGaia", "[", "Gstar_", "]"}], ":=", 
  RowBox[{"Max", "[", 
   RowBox[{
    SuperscriptBox["10", 
     RowBox[{"0.4", "*", 
      RowBox[{"(", 
       RowBox[{"13", "-", "15"}], ")"}]}]], ",", 
    SuperscriptBox["10", 
     RowBox[{"0.4", "*", 
      RowBox[{"(", 
       RowBox[{"Gstar", "-", "15"}], ")"}]}]]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.952290812726527*^9, 3.9522908492421837`*^9}},
 CellLabel->
  "In[1266]:=",ExpressionUUID->"1b8a6201-279d-41c7-aa56-b05a8b356a00"],

