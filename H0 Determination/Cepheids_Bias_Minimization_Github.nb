Cell[BoxData[
 RowBox[{
  RowBox[{"\[Mu]AsToRadians", "=", 
   RowBox[{
    FractionBox["\[Pi]", "648000"], "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "6"}]]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.952292482370779*^9, 3.9522925031221657`*^9}},
