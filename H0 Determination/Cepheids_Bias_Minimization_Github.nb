Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"combinedCDLPlot", "=", 
  RowBox[{"Show", "[", 
   RowBox[{
   "SH0ESUncertaintyPlot", ",", 
    "optimum\[Sigma]\[CapitalDelta]\[Mu]CepheidPlot", ",", 
    "optimum\[Sigma]\[CapitalDelta]\[Mu]TypeIaPlot", ",", 
    "optimum\[Sigma]\[CapitalDelta]\[Mu]CepheidSingleTypeIISNPlot", ",", 
    "optimum\[Sigma]\[CapitalDelta]\[Mu]CepheidSingleTypeIaSNPlot", ",", 
    "SH0ESLinePlotUncertaintyPlot", ",", "\[IndentingNewLine]", 
    RowBox[{"Epilog", "->", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"Rotate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"changeStyle", "[", 
               RowBox[{"Darker", "[", 
                RowBox[{
                 RowBox[{"color", "[", "1", "]"}], ",", ".3"}], "]"}], "]"}], 
              "@", 
              RowBox[{"MaTeX", "[", 
               RowBox[{"\"\<\\\\sigma_{\\\\rm rung \\\\, 1,EEM}\>\"", ",", 
                RowBox[{"Magnification", "\[Rule]", "1.45"}]}], "]"}]}], ",", 
             
             RowBox[{
              RowBox[{"-", "35"}], "Degree"}]}], "]"}], "]"}], ",", 
          RowBox[{"Scaled", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{".15", "-", ".02", "+", ".1", "+", ".05", "-", ".075"}], 
             ",", 
             RowBox[{
             "0.48", "+", ".05", "-", ".05", "+", ".075", "-", ".125"}]}], 
            "}"}], "]"}]}], "]"}], ","}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Inset", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"Rotate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"changeStyle", "[", 
              RowBox[{"Darker", "[", 
               RowBox[{
                RowBox[{"color", "[", "1", "]"}], ",", ".3"}], "]"}], "]"}], 
             "@", 
             RowBox[{"MaTeX", "[", 
              RowBox[{"\"\<\\\\sigma_{\\\\rm rung \\\\, 1,EEM}\>\"", ",", 
