Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Let", "  ", 
    SuperscriptBox["xi", "2"]}], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[Sigma]DOverD", 
       RowBox[{"(", 
        RowBox[{"m", ",", "t"}], ")"}]}], ")"}], "2"], "+", 
    RowBox[{"\[Sigma]Cepheid", 
     SuperscriptBox[
      RowBox[{"(", "m", ")"}], "2"]}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"where", " ", "\[Sigma]DOverD", 
    RowBox[{"(", 
     RowBox[{"m", ",", "t"}], ")"}]}], "=", 
   RowBox[{"\[Sigma]DOverD", 
    RowBox[{"(", 
     RowBox[{"m", ",", "t0"}], ")"}], "*", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["t0", "t"], ")"}], 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}]]}]}], ",", " ", 
  RowBox[{
   RowBox[{"where", " ", "\[Sigma]DOverD", 
    RowBox[{"(", 
     RowBox[{"m", ",", "t0"}], ")"}]}], " ", "=", 
   RowBox[{"6.3", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "2"}]], "*", 
    SuperscriptBox["10", 
     RowBox[{"0.4", 
      RowBox[{"(", 
       RowBox[{"m", "-", "12.0"}], ")"}]}]], "*", 
    RowBox[{"1", "/", "ML"}]}]}], ",", " ", 
  RowBox[{
   RowBox[{"and", " ", "t0"}], "=", 
   RowBox[{
    RowBox[{"6", "hrs", " ", "and", " ", "ML"}], " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["\[Sigma]t", 
        RowBox[{"10", "ps"}]], ")"}], 
      RowBox[{"1", "/", "2"}]], "*", 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["A", 
        RowBox[{"\[Pi]", "*", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"5", "m"}], ")"}], "2"]}]], ")"}], 
      RowBox[{"-", "1"}]], "*", 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["R", 
        SuperscriptBox["10", "4"]], ")"}], 
      RowBox[{
       RowBox[{"-", "1"}], "/", "2"}]], "*", 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["narr", "1"], ")"}], 
      RowBox[{"-", "1"}]]}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"and", " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Sigma]Cepheid", 
     RowBox[{"(", "m", ")"}]}], "\[TildeTilde]", 
    RowBox[{"(", 
     RowBox[{"0.5", "*", 
      SuperscriptBox["10", 
       RowBox[{"-", "2"}]]}], ")"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Maximize", " ", "the", " ", "sum", " ", 
     RowBox[{"\[Sum]", 
      FractionBox["1", 
       SuperscriptBox["xi", "2"]]}]}], "=", 
    RowBox[{"\[Sum]", 
     FractionBox["1", 
      RowBox[{"xi", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"mi", ",", "ti"}], ")"}], "2"]}]]}]}], ",", " ", 
   RowBox[{
    RowBox[{"under", " ", "the", " ", "constraint", " ", "that", " ", 
     RowBox[{"\[Sum]", "ti"}]}], "=", "tyr"}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "or", " ", "whatever", " ", "fraction", " ", "of", " ", "a", " ", "year", 
    " ", "is", " ", "used", " ", "for", " ", "observation", " ", "time"}], 
   ",", " ", 
   RowBox[{"like", " ", 
    RowBox[{"1", "/", "4"}], " ", "of", " ", "a", " ", "year", " ", "etc"}]}],
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Let", " ", "L"}], "=", 
   RowBox[{
    RowBox[{"\[Sum]", 
     FractionBox["1", 
      RowBox[{"xi", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"mi", ",", "ti"}], ")"}], "2"]}]]}], "-", 
