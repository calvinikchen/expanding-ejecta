Cell[BoxData[
 RowBox[{
  RowBox[{"\[Sigma]\[Omega]bar", "[", "Gstar_", "]"}], ":=", 
  RowBox[{"\[Mu]AsToRadians", "*", "Tfactor", "*", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"40", "+", 
      RowBox[{"800", "*", 
       RowBox[{"zGaia", "[", "Gstar", "]"}]}], "+", 
      RowBox[{"30", "*", 
       SuperscriptBox[
        RowBox[{"zGaia", "[", "Gstar", "]"}], "2"]}]}], ")"}], 
    RowBox[{"1", "/", "2"}]]}]}]], "Input",
