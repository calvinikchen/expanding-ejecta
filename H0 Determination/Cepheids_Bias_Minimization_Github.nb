Cell[BoxData[
 RowBox[{
  RowBox[{"tiLangrangeMultiplierTypeIa", "[", 
   RowBox[{
   "inputSNList_", ",", "tTotalObservationhr_", ",", "snrEnhancement_"}], 
   "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"snPopList", "=", "inputSNList"}], ";", "\[IndentingNewLine]", 
    RowBox[{"sum1UncertaintyRatio", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           RowBox[{"\[Sigma]DoverDt0", "[", 
            RowBox[{
             RowBox[{"snPopList", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "snrEnhancement"}], "]"}], 
           
           RowBox[{"\[Sigma]CalibratorTypeIa", "[", 
            RowBox[{"snPopList", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}]], ")"}], "2"], "t0hr"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "snPopList", "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"sum2UncertaintyRatio", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"(", 
        FractionBox[
         RowBox[{"\[Sigma]DoverDt0", "[", 
          RowBox[{
           RowBox[{"snPopList", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", "snrEnhancement"}], "]"}], 
         SuperscriptBox[
          RowBox[{"\[Sigma]CalibratorTypeIa", "[", 
           RowBox[{"snPopList", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "2"]], ")"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "snPopList", "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"tiIdealTypeIaTab", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"mi", "=", 
         RowBox[{"snPopList", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ti", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"tTotalObservationhr", "+", "sum1UncertaintyRatio"}], 
            ")"}], "*", 
           FractionBox[
            FractionBox[
             RowBox[{"\[Sigma]DoverDt0", "[", 
              RowBox[{"mi", ",", "snrEnhancement"}], "]"}], 
             SuperscriptBox[
              RowBox[{"\[Sigma]CalibratorTypeIa", "[", "mi", "]"}], "2"]], 
            "sum2UncertaintyRatio"]}], "-", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox[
              RowBox[{"\[Sigma]DoverDt0", "[", 
               RowBox[{"mi", ",", "snrEnhancement"}], "]"}], 
              RowBox[{"\[Sigma]CalibratorTypeIa", "[", "mi", "]"}]], ")"}], 
            "2"], "*", "t0hr"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"mi", ",", "ti"}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "snPopList", "]"}]}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", ")"}]}]], "Input",
 CellChangeTimes->{{3.951901539604334*^9, 3.951901667190728*^9}, {
   3.951919205805913*^9, 3.951919242941379*^9}, {3.951925109402576*^9, 
   3.9519251354267*^9}, 3.952695425182323*^9, 3.952695658955901*^9},
 CellLabel->
  "In[1458]:=",ExpressionUUID->"da0400d8-4354-4538-a6ba-89e066bf1ecd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tiIdealTypeIaList", "[", 
   RowBox[{
    RowBox[{"tTotalObservationhr_", "?", "NumericQ"}], ",", "snrEnhancement_",
     ",", 
    RowBox[{"trialNum_", ":", "0"}], ",", 
    RowBox[{"numOftPlateauSN_", ":", "0"}], ",", 
    RowBox[{"fiducialNumSN_", ":", 
     RowBox[{"-", "1"}]}]}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"trialNum", "==", "0"}], ",", "\[IndentingNewLine]", 
      RowBox[{"snPop", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"snYearRealization", "[", 
         RowBox[{"m0CDF", ",", "18", ",", "b0CDF", ",", "typeIaFraction"}], 
         "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"snPop", "=", 
       RowBox[{
        RowBox[{"snPopulationTrialsTypeIa", "[", 
         RowBox[{"[", "trialNum", "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"numOftPlateauSN", "+", "1"}], ";;", "fiducialNumSN"}], 
         "]"}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"tiTimesPositiveDefinite", "=", "False"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"snListLength", "=", 
     RowBox[{"Length", "[", "snPop", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"reducedSNPopList", "=", "snPop"}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"While", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tiTimesPositiveDefinite", "===", "False"}], ",", 
