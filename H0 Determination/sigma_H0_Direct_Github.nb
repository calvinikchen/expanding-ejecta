             RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"coarseTab", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", "min\[Sigma]HoverHTot", ",", 
           "peakTypeIIDistance"}], "}"}]}], "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "coarseTab", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"\[Sigma]HOverHvsCoarsenessTab", "=", 
