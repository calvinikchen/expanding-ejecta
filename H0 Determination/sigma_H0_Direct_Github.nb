Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"findZeroCoarseness\[Sigma]HoverH", "[", "dataTab_", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fit", "=", 
      RowBox[{"NonlinearModelFit", "[", 
       RowBox[{"dataTab", ",", 
        RowBox[{
         RowBox[{"a", "*", "x"}], "+", "b"}], ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], ",", "x"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fitFunction", "=", 
      RowBox[{"Normal", "[", "fit", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"intercept", "=", 
      RowBox[{"fitFunction", "/.", 
       RowBox[{"{", 
        RowBox[{"x", "->", "0"}], "}"}]}]}]}], "\[IndentingNewLine]", ")"}]}],
   "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.955065810317684*^9, 3.955065867508419*^9}, 
   3.955065897825873*^9},
 CellLabel->
  "In[2530]:=",ExpressionUUID->"d1fe0531-4610-4280-9974-a6faf4a3d049"],

Cell[BoxData[
 RowBox[{
  RowBox[{"findPeakTypeIaDistance", "[", 
   RowBox[{"inputCoarseSNList_", ",", "timeTab_", ",", "timeSol_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"timeTabSol", "=", 
     RowBox[{"timeTab", "/.", 
      RowBox[{"minSol", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"tObsSolTab", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"inputCoarseSNList", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"timeTabSol", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "*", 
          RowBox[{"inputCoarseSNList", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "inputCoarseSNList", "]"}]}], "}"}]}], 
      "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"peakObsTime", "=", 
     RowBox[{"Max", "[", 
      RowBox[{"tObsSolTab", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"peakObsTimePos", "=", 
     RowBox[{
      RowBox[{"Last", "[", 
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"tObsSolTab", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "peakObsTime"}], 
        "]"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"peakApparentMag", "=", 
     RowBox[{"tObsSolTab", "[", 
      RowBox[{"[", 
       RowBox[{"peakObsTimePos", ",", "1"}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"peakDistanceIa", "=", 
     RowBox[{"Dofm", "[", 
      RowBox[{"peakApparentMag", ",", "MSNIa"}], "]"}]}]}], 
   "\[IndentingNewLine]", ")"}]}]], "Input",
 CellChangeTimes->{{3.955192465671287*^9, 3.95519247332957*^9}},
 CellLabel->
  "In[2531]:=",ExpressionUUID->"6099efc4-7edc-459d-8327-adcce60284fa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"numericalMinimizationTypeIa", "[", 
    RowBox[{"inputSNList_", ",", "totalObsTime_", ",", "snrEnhancement_"}], 
    "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"snPopList", "=", "inputSNList"}], ";", "\[IndentingNewLine]", 
     RowBox[{"coarseVS\[Sigma]HOverHTab", "=", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"coarseSNPopTab", "=", 
          RowBox[{"Round", "[", 
           RowBox[{"snPopList", ",", 
            RowBox[{"coarseTab", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"gatherTab", "=", 
          RowBox[{
           RowBox[{"Gather", "[", "coarseSNPopTab", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", 
             RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"lengthCoarseTab", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"gatherTab", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"Length", "[", 
               RowBox[{"gatherTab", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"Length", "[", "gatherTab", "]"}]}], "}"}]}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"timeTab", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"ToExpression", "[", 
             RowBox[{"\"\<t\>\"", "<>", 
              RowBox[{"ToString", "[", "i", "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"Length", "[", "lengthCoarseTab", "]"}]}], "}"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"sumTimeTab", "=", 
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"timeTab", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "*", 
              RowBox[{"lengthCoarseTab", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"Length", "[", "timeTab", "]"}]}], "}"}]}], "]"}], "==",
            "totalObsTime"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"inequalityTimeTab", "=", 
