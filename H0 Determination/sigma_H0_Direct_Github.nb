Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"redoIdeal\[Sigma]\[Mu]HistogramSNTypeII", "[", 
     RowBox[{"inputSNList_", ",", "snrEnhancement_", ",", "trialNum_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"snPopList", "=", "inputSNList"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"tObsOfBrightestSN", "=", 
          RowBox[{"snPopList", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"tObsOfBrightestSN", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"snPopList", "[", 
           RowBox[{"[", 
            RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"totalObsTimeForOptimization", "=", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"snPopList", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "snPopList", "]"}]}], "}"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"numOfFiducialSN", "=", 
         RowBox[{"Length", "[", "snPopList", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"numOftPlateauSN", "=", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"updatedtiIdealSNTypeIIList", "=", "snPopList"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"tObsOfBrightestSN", ">", "tPlateauTypeII"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"numOftPlateauSN", "=", 
            RowBox[{"numOftPlateauSN", "+", "1"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"updatedtiIdealSNTypeIIList", "=", 
            RowBox[{"tiIdealSNTypeIIList", "[", 
             RowBox[{
              RowBox[{"totalObsTimeForOptimization", "-", "tPlateauTypeII"}], 
              ",", "snrEnhancement", ",", "trialNum", ",", "numOftPlateauSN", 
              ",", 
              RowBox[{"numOfFiducialSN", "+", "30"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"tObsOfBrightestSN", "=", 
              RowBox[{"updatedtiIdealCepheidsList", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"tObsOfBrightestSN", "=", 
            RowBox[{"Max", "[", 
             RowBox[{"updatedtiIdealSNTypeIIList", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"totalObsTimeForOptimization", "=", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{"updatedtiIdealSNTypeIIList", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", 
                RowBox[{"Length", "[", "updatedtiIdealSNTypeIIList", "]"}]}], 
               "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"numOfFiducialSN", "=", 
            RowBox[{"Length", "[", "updatedtiIdealSNTypeIIList", "]"}]}], 
           ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"plateauSNTab", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"snPopulationTrialsTypeII", "[", 
              RowBox[{"[", 
               RowBox[{"trialNum", ",", "i"}], "]"}], "]"}], ",", 
             "tPlateauTypeII"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "numOftPlateauSN"}], "}"}]}], "]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"Join", "[", 
         RowBox[{"plateauSNTab", ",", "updatedtiIdealSNTypeIIList"}], "]"}]}],
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"{", 
         RowBox[{"snPopList", ",", "updatedtiIdealCepheidsList"}], "}"}], 
        "*)"}], "\[IndentingNewLine]", ")"}]}], "]"}]}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"redoIdeal\[Sigma]\[Mu]HistogramSNTypeII", "[", 
    RowBox[{"inputSNList_", ",", "snrEnhancement_", ",", "trialNum_"}], "]"}],
    ":=", 
