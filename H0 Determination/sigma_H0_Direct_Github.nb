Cell[CellGroupData[{

Cell["Lagrange Multiplier Analysis (Stat only, no cosmic variance)", \
"Subsubsubsection",
 CellChangeTimes->{{3.9532878818917437`*^9, 3.953287888879106*^9}, {
  3.9600013655838614`*^9, 
  3.960001399779516*^9}},ExpressionUUID->"568f368f-ac52-4986-848d-\
15c67f4b7567"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tiLangrangeMultiplierSNTypeIa", "[", 
   RowBox[{
   "inputSNList_", ",", "tTotalObservationhr_", ",", "snrEnhancement_"}], 
   "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"snPopList", "=", "inputSNList"}], ";", "\[IndentingNewLine]", 
    RowBox[{"sum1UncertaintyRatio", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           RowBox[{"\[Sigma]DoverDt0", "[", 
            RowBox[{
             RowBox[{"snPopList", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "snrEnhancement"}], "]"}], 
           
           RowBox[{"\[Sigma]vSNTypeIa", "[", 
            RowBox[{"snPopList", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}]], ")"}], "2"], "t0hr"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "snPopList", "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"sum2UncertaintyRatio", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"(", 
        FractionBox[
         RowBox[{"\[Sigma]DoverDt0", "[", 
          RowBox[{
           RowBox[{"snPopList", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", "snrEnhancement"}], "]"}], 
         SuperscriptBox[
          RowBox[{"\[Sigma]vSNTypeIa", "[", 
           RowBox[{"snPopList", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "2"]], ")"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "snPopList", "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"tiIdealSNIITab", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"mi", "=", 
         RowBox[{"snPopList", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ti", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"tTotalObservationhr", "+", "sum1UncertaintyRatio"}], 
            ")"}], "*", 
           FractionBox[
            FractionBox[
             RowBox[{"\[Sigma]DoverDt0", "[", 
              RowBox[{"mi", ",", "snrEnhancement"}], "]"}], 
             SuperscriptBox[
              RowBox[{"\[Sigma]vSNTypeIa", "[", "mi", "]"}], "2"]], 
            "sum2UncertaintyRatio"]}], "-", 
