Cell["Lagrange Multiplier Analysis (Stat only, no cosmic variance)", \
"Subsubsubsection",
 CellChangeTimes->{{3.9534561396817713`*^9, 3.9534561419234324`*^9}, {
  3.953470844819018*^9, 3.953470848851201*^9}, {3.960001392792392*^9, 
