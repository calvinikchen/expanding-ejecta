Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"findZeroCoarseness\[Sigma]HoverH", "[", "dataTab_", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fit", "=", 
      RowBox[{"NonlinearModelFit", "[", 
       RowBox[{"dataTab", ",", 
        RowBox[{
         RowBox[{"a", "*", "x"}], "+", "b"}], ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], ",", "x"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fitFunction", "=", 
      RowBox[{"Normal", "[", "fit", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"intercept", "=", 
      RowBox[{"fitFunction", "/.", 
       RowBox[{"{", 
        RowBox[{"x", "->", "0"}], "}"}]}]}]}], "\[IndentingNewLine]", ")"}]}],
   "\[IndentingNewLine]"}]], "Input",
