   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dTabTypeIaLongTicks", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"magTypeIa", "[", 
             RowBox[{"10", "^", "j"}], "]"}], ",", 
            RowBox[{"Which", "[", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"EvenQ", "[", "j", "]"}], ",", "\"\<\>\"", ","}], 
              "*)"}], 
             RowBox[{
              RowBox[{"j", "\[Equal]", "0"}], ",", 
              RowBox[{"MaTeX", "[", 
               RowBox[{"1", ",", 
                RowBox[{"Magnification", "\[Rule]", "1.5"}]}], "]"}], ",", 
              RowBox[{"j", "\[Equal]", "1"}], ",", 
              RowBox[{"MaTeX", "[", 
               RowBox[{"10", ",", 
                RowBox[{"Magnification", "\[Rule]", "1.5"}]}], "]"}], ",", 
              "True", ",", 
              RowBox[{"MaTeX", "[", 
               RowBox[{
                RowBox[{"Power", "[", 
                 RowBox[{"10", ",", 
                  RowBox[{"ToString", "[", "j", "]"}]}], "]"}], ",", 
                RowBox[{"Magnification", "\[Rule]", "1.5"}]}], "]"}]}], "]"}],
             ",", 
            RowBox[{"{", 
             RowBox[{"0.025", ",", "0"}], "}"}]}], "}"}], "}"}], ",", 
