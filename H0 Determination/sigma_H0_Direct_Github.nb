 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
    "LocalTickmofDistanceWithCVOrangeSNTypeIaNumericOptimization", "[", "j_", 
     "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Log10", "[", 
         RowBox[{"peakSNIaMLvsDistanceNumericOptimization", "[", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"j", "+", 
             RowBox[{"Log10", "[", "k", "]"}]}], ")"}]}], "]"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"tickNum", "=", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"j", "+", 
             RowBox[{"Log10", "[", "k", "]"}]}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"maTexTickNum", "=", 
          RowBox[{
           RowBox[{"changeStyle", "[", 
            RowBox[{"Darker", "[", 
             RowBox[{
              RowBox[{"color", "[", "2", "]"}], ",", ".3"}], "]"}], "]"}], 
           "@", 
           RowBox[{"MaTeX", "[", 
            RowBox[{"tickNum", ",", 
             RowBox[{"Magnification", "\[Rule]", "1.75"}]}], "]"}]}]}]}]}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "2", ",", "9"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"distanceWithCVTabOrangeSNTypeIaNumericOptimization", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Log10", "[", 
              RowBox[{"peakSNIaMLvsDistanceNumericOptimization", "[", 
               RowBox[{"10", "^", "j"}], "]"}], "]"}], ",", 
             RowBox[{"Which", "[", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{"EvenQ", "[", "j", "]"}], ",", "\"\<\>\"", ","}], 
               "*)"}], "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"j", "\[Equal]", "0"}], ",", 
               RowBox[{"MaTeX", "[", 
                RowBox[{"1", ",", 
                 RowBox[{"Magnification", "\[Rule]", "1.75"}]}], "]"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"j", "\[Equal]", "1"}], ",", 
               RowBox[{
                RowBox[{"changeStyle", "[", 
                 RowBox[{"Darker", "[", 
                  RowBox[{
                   RowBox[{"color", "[", "2", "]"}], ",", ".3"}], "]"}], 
                 "]"}], "@", 
                RowBox[{"MaTeX", "[", 
                 RowBox[{"10", ",", 
                  RowBox[{"Magnification", "\[Rule]", "1.75"}]}], "]"}]}], 
               ",", "\[IndentingNewLine]", 
               RowBox[{"j", "\[Equal]", "2"}], ",", 
               RowBox[{
                RowBox[{"changeStyle", "[", 
                 RowBox[{"Darker", "[", 
                  RowBox[{
                   RowBox[{"color", "[", "2", "]"}], ",", ".3"}], "]"}], 
                 "]"}], "@", 
                RowBox[{"MaTeX", "[", 
                 RowBox[{"100", ",", 
                  RowBox[{"Magnification", "\[Rule]", "1.75"}]}], "]"}]}], 
               ",", "True", ",", 
               RowBox[{
                RowBox[{"changeStyle", "[", 
                 RowBox[{"Darker", "[", 
                  RowBox[{
                   RowBox[{"color", "[", "2", "]"}], ",", ".3"}], "]"}], 
                 "]"}], "@", 
                RowBox[{"MaTeX", "[", 
                 RowBox[{
                  RowBox[{"Power", "[", 
                   RowBox[{"10", ",", 
                    RowBox[{"ToString", "[", "j", "]"}]}], "]"}], ",", 
                  RowBox[{"Magnification", "\[Rule]", "1.75"}]}], "]"}]}]}], 
              "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"0.025", ",", "0"}], "}"}]}], "}"}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Table", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
               "LocalTickmofDistanceWithCVOrangeSNTypeIaNumericOptimization", 
                "[", "j", "]"}], "[", 
               RowBox[{"[", "k", "]"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"0.5", "*", ".025"}], ",", "0"}], "}"}], "}"}]}], 
             "]"}], 
