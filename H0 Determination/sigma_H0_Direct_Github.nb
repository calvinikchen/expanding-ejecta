Cell[BoxData[
 RowBox[{
  RowBox[{"findPeakTypeIIDistance", "[", 
   RowBox[{"inputCoarseSNList_", ",", "timeTab_", ",", "timeSol_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"timeTabSol", "=", 
     RowBox[{"timeTab", "/.", 
      RowBox[{"minSol", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"tObsSolTab", "=", 
