Cell[BoxData[
 RowBox[{
  RowBox[{"tiIdealSNTypeIIList", "[", 
   RowBox[{
    RowBox[{"tTotalObservationhr_", "?", "NumericQ"}], ",", "snrEnhancement_",
     ",", 
    RowBox[{"trialNum_", ":", "0"}], ",", 
    RowBox[{"numOftPlateauSN_", ":", "0"}], ",", 
    RowBox[{"fiducialNumSN_", ":", 
     RowBox[{"-", "1"}]}], ",", 
    RowBox[{"posOfBrightestSNTab_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{"(*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"trialNum", "==", "0"}], ",", 
       RowBox[{"snPop", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{"snYearRealization", "[", 
          RowBox[{"12", ",", "19", ",", ".48", ",", 
           RowBox[{"typeIIFraction", "*", "subtypeFraction"}]}], "]"}], 
         "]"}]}], ",", 
       RowBox[{"snPop", "=", 
        RowBox[{
         RowBox[{"snPopulationTrialsTypeII", "[", 
          RowBox[{"[", "trialNum", "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"numOftPlateauSN", "+", "1"}], ";;", "fiducialNumSN"}], 
          "]"}], "]"}]}]}], "]"}], ";"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Which", "[", 
     RowBox[{
      RowBox[{"trialNum", "==", "0"}], ",", 
      RowBox[{"snPop", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"snYearRealization", "[", 
         RowBox[{"m0CDF", ",", "19", ",", "b0CDF", ",", 
          RowBox[{"typeIIFraction", "*", "subtypeFraction"}]}], "]"}], 
        "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"fiducialNumSN", "===", 
       RowBox[{"-", "1"}]}], ",", 
      RowBox[{"snPop", "=", 
       RowBox[{
        RowBox[{"snPopulationTrialsTypeII", "[", 
         RowBox[{"[", "trialNum", "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "fiducialNumSN"}], "]"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "True", ",", 
      RowBox[{"snPop", "=", 
       RowBox[{
        RowBox[{"Delete", "[", 
         RowBox[{
          RowBox[{"snPopulationTrialsTypeII", "[", 
           RowBox[{"[", "trialNum", "]"}], "]"}], ",", 
          "posOfBrightestSNTab"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "fiducialNumSN"}], "]"}], "]"}]}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"tiTimesPositiveDefinite", "=", "False"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"snListLength", "=", 
     RowBox[{"Length", "[", "snPop", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"reducedSNPopList", "=", "snPop"}], ";", "\[IndentingNewLine]", 
    RowBox[{"While", "[", 
     RowBox[{
      RowBox[{"tiTimesPositiveDefinite", "===", "False"}], ",", 
      RowBox[{
       RowBox[{"newtiTab", "=", 
        RowBox[{"tiLangrangeMultiplierSNTypeII", "[", 
         RowBox[{
         "reducedSNPopList", ",", "tTotalObservationhr", ",", 
          "snrEnhancement"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"observationTimeofBrightestSN", "=", 
        RowBox[{
         RowBox[{"newtiTab", "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"observationTimeofBrightestSN", "<=", "0"}], ",", 
         RowBox[{
          RowBox[{"reducedSNPopList", "=", 
           RowBox[{"Drop", "[", 
            RowBox[{"reducedSNPopList", ",", 
             RowBox[{"-", "1"}]}], "]"}]}], ";"}], ",", 
         RowBox[{"tiTimesPositiveDefinite", "=", "True"}]}], "]"}], ";"}]}], 
     "]"}], ";", "\[IndentingNewLine]", "newtiTab"}], ")"}]}]], "Input",
 CellChangeTimes->{{3.953219833575281*^9, 3.9532198486105433`*^9}, {
   3.953222487394751*^9, 3.9532225041770782`*^9}, {3.9532226178158207`*^9, 
