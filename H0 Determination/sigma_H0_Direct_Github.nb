Cell[BoxData[{
 RowBox[{
  RowBox[{"CDF", "[", "m", "]"}], "=", 
  RowBox[{
   RowBox[{"A", 
    RowBox[{
     SuperscriptBox["\[Integral]", "m"], 
     RowBox[{"f", 
      RowBox[{"(", 
       RowBox[{"m", "'"}], ")"}], 
      RowBox[{"dm", "'"}]}]}]}], "=", 
   RowBox[{"A", "*", 
    SuperscriptBox["10", 
     RowBox[{"b", 
      RowBox[{"(", 
       RowBox[{"m", "-", "m0"}], ")"}]}]]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PDF", "[", "m", "]"}], "=", 
  RowBox[{
   RowBox[{"d", 
    FractionBox[
     RowBox[{"(", 
      RowBox[{"CDF", "[", "m", "]"}], ")"}], "dm"]}], 
   "="}]}]}], "DisplayFormula",
 CellChangeTimes->{{3.951482944268737*^9, 
  3.951483046344675*^9}},ExpressionUUID->"b735ba47-1ed1-4a8a-bbc6-\
4bf0e9276317"],

