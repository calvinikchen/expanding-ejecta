 RowBox[{
  RowBox[{"typeIaTickLong", "[", "j_", "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"magTypeIa", "[", 
       RowBox[{"10", "^", 
        RowBox[{"(", 
         RowBox[{"j", "+", 
          RowBox[{"Log10", "[", "k", "]"}]}], ")"}]}], "]"}], ",", "\"\<\>\"",
       ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"0.025", "*", ".5"}], ",", "0"}], "}"}]}], "}"}], ",", 
    RowBox[{"{", 
