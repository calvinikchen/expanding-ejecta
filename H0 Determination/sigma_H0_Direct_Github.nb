Cell[BoxData[
 RowBox[{
  RowBox[{"tiLangrangeMultiplierSNTypeII", "[", 
   RowBox[{
   "inputSNList_", ",", "tTotalObservationhr_", ",", "snrEnhancement_"}], 
   "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"snPopList", "=", "inputSNList"}], ";", "\[IndentingNewLine]", 
    RowBox[{"sum1UncertaintyRatio", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           RowBox[{"\[Sigma]DoverDt0", "[", 
            RowBox[{
             RowBox[{"snPopList", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "snrEnhancement"}], "]"}], 
           
           RowBox[{"\[Sigma]vSNTypeII", "[", 
            RowBox[{"snPopList", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}]], ")"}], "2"], "t0hr"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "snPopList", "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"sum2UncertaintyRatio", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"(", 
        FractionBox[
         RowBox[{"\[Sigma]DoverDt0", "[", 
          RowBox[{
           RowBox[{"snPopList", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", "snrEnhancement"}], "]"}], 
         SuperscriptBox[
          RowBox[{"\[Sigma]vSNTypeII", "[", 
           RowBox[{"snPopList", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "2"]], ")"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "snPopList", "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"tiIdealSNIITab", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"mi", "=", 
         RowBox[{"snPopList", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ti", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"tTotalObservationhr", "+", "sum1UncertaintyRatio"}], 
            ")"}], "*", 
           FractionBox[
            FractionBox[
             RowBox[{"\[Sigma]DoverDt0", "[", 
              RowBox[{"mi", ",", "snrEnhancement"}], "]"}], 
             SuperscriptBox[
              RowBox[{"\[Sigma]vSNTypeII", "[", "mi", "]"}], "2"]], 
            "sum2UncertaintyRatio"]}], "-", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox[
              RowBox[{"\[Sigma]DoverDt0", "[", 
               RowBox[{"mi", ",", "snrEnhancement"}], "]"}], 
              RowBox[{"\[Sigma]vSNTypeII", "[", "mi", "]"}]], ")"}], "2"], 
           "*", "t0hr"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"mi", ",", "ti"}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "snPopList", "]"}]}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", ")"}]}]], "Input",
 CellChangeTimes->{{3.951901539604334*^9, 3.951901667190728*^9}, {
   3.951919205805913*^9, 3.951919242941379*^9}, 3.952694647315954*^9, 
   3.952694712428619*^9, 3.953219675151029*^9, {3.9532197188858423`*^9, 
