Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"numericalMinimizationTypeII", "[", 
    RowBox[{"inputSNList_", ",", "totalObsTime_", ",", "snrEnhancement_"}], 
    "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"snPopList", "=", "inputSNList"}], ";", "\[IndentingNewLine]", 
     RowBox[{"coarseVS\[Sigma]HOverHTab", "=", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"coarseSNPopTab", "=", 
          RowBox[{"Round", "[", 
           RowBox[{"snPopList", ",", 
            RowBox[{"coarseTab", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"gatherTab", "=", 
          RowBox[{
           RowBox[{"Gather", "[", "coarseSNPopTab", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", 
             RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"lengthCoarseTab", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"gatherTab", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"Length", "[", 
               RowBox[{"gatherTab", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"Length", "[", "gatherTab", "]"}]}], "}"}]}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"timeTab", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"ToExpression", "[", 
             RowBox[{"\"\<t\>\"", "<>", 
              RowBox[{"ToString", "[", "i", "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"Length", "[", "lengthCoarseTab", "]"}]}], "}"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"sumTimeTab", "=", 
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"timeTab", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "*", 
              RowBox[{"lengthCoarseTab", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"Length", "[", "timeTab", "]"}]}], "}"}]}], "]"}], "==",
            "totalObsTime"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"inequalityTimeTab", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"timeTab", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ">", 
             SuperscriptBox["10", 
              RowBox[{"-", "8"}]]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"Length", "[", "timeTab", "]"}]}], "}"}]}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"constraints", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"{", 
            RowBox[{"sumTimeTab", ",", "inequalityTimeTab"}], "}"}], "]"}]}], 
         ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"lagrangianNumerator", "=", 
          RowBox[{"1", "+", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"lengthCoarseTab", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "2"}], "]"}], "]"}], "*", 
                SuperscriptBox[
                 RowBox[{"fCVSNTypeII", "[", 
                  RowBox[{"lengthCoarseTab", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "2"]}], 
               ")"}], "/", 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"\[Sigma]DoverDt", "[", 
                  RowBox[{
                   RowBox[{"lengthCoarseTab", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
                   "snrEnhancement", ",", 
                   RowBox[{"timeTab", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "2"], "+", 
                SuperscriptBox[
                 RowBox[{"\[Sigma]vSNTypeII", "[", 
                  RowBox[{"lengthCoarseTab", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "2"]}], 
               ")"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"Length", "[", "lengthCoarseTab", "]"}]}], "}"}]}], 
            "]"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"lagrangianDenominatorSum1", "=", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"lengthCoarseTab", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "2"}], "]"}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"\[Sigma]DoverDt", "[", 
                 RowBox[{
                  RowBox[{"lengthCoarseTab", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
                  "snrEnhancement", ",", 
                  RowBox[{"timeTab", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "2"], "+", 
               SuperscriptBox[
                RowBox[{"\[Sigma]vSNTypeII", "[", 
                 RowBox[{"lengthCoarseTab", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "2"]}], 
              ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"Length", "[", "lengthCoarseTab", "]"}]}], "}"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"lagrangianDenominatorSum2", "=", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"lengthCoarseTab", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "2"}], "]"}], "]"}], "/", 
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"\[Sigma]DoverDt", "[", 
                   RowBox[{
                    RowBox[{"lengthCoarseTab", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
                    "snrEnhancement", ",", 
                    RowBox[{"timeTab", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "2"], "+", 
                 SuperscriptBox[
                  RowBox[{"\[Sigma]vSNTypeII", "[", 
                   RowBox[{"lengthCoarseTab", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "2"]}], 
                ")"}]}], ")"}], "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"lengthCoarseTab", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "2"}], "]"}], "]"}], "/", 
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"\[Sigma]DoverDt", "[", 
                   RowBox[{
                    RowBox[{"lengthCoarseTab", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "1"}], "]"}], "]"}], ",", 
                    "snrEnhancement", ",", 
                    RowBox[{"timeTab", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "2"], "+", 
                 SuperscriptBox[
                  RowBox[{"\[Sigma]vSNTypeII", "[", 
                   RowBox[{"lengthCoarseTab", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "1"}], "]"}], "]"}], "]"}], "2"]}], 
                ")"}]}], ")"}], "*", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{"fCVSNTypeII", "[", 
                 RowBox[{"lengthCoarseTab", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "-", 
                RowBox[{"fCVSNTypeII", "[", 
                 RowBox[{"lengthCoarseTab", "[", 
                  RowBox[{"[", 
                   RowBox[{"j", ",", "1"}], "]"}], "]"}], "]"}]}], ")"}], 
              "2"]}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"Length", "[", "lengthCoarseTab", "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", 
              RowBox[{"Length", "[", "lengthCoarseTab", "]"}]}], "}"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"lagrangian", "=", 
          SqrtBox[
           FractionBox["lagrangianNumerator", 
            RowBox[{
            "lagrangianDenominatorSum1", "+", 
             "lagrangianDenominatorSum2"}]]]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"minSol", "=", 
          RowBox[{"NMinimize", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"lagrangian", ",", "constraints"}], "}"}], ",", 
            "timeTab", ",", 
            RowBox[{"Method", "->", "\"\<SimulatedAnnealing\>\""}]}], 
           RowBox[{"(*", 
            RowBox[{",", 
             RowBox[{"AccuracyGoal", "->", "6"}]}], "*)"}], 
           RowBox[{"(*", "6", "*)"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"min\[Sigma]HoverHTot", "=", 
          RowBox[{"minSol", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
